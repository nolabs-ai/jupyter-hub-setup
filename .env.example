# Required
DOMAIN=jhub.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Google OAuth client credentials (GCP console -> APIs & Services -> Credentials ->
# OAuth client ID, type "Web application"). Restrict the consent screen to your Workspace.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Callback must match an Authorized redirect URI on the OAuth client
OAUTH_CALLBACK_URL=https://${DOMAIN}/hub/oauth_callback

# Hub base path (normally "/")
HUB_BASE_URL=/

# Domain-based access control (preferred):
# Comma-separated Google Workspace domains. Anyone signing in with an account in one of
# these domains is allowed. Example: nolabs.ai
ALLOWED_DOMAINS=nolabs.ai

# Optional: explicit account emails allowed (comma-separated, additive to ALLOWED_DOMAINS).
# You can also drop emails in /srv/jupyterhub/allowed_users.txt at runtime.
ALLOWED_USERS=

# Optional admins (subset of allowed users), by email
ADMIN_USERS=you@nolabs.ai

# Single-user notebook image (choose one):
# SkyPilot-ready (JupyterLab + SkyPilot client + gcloud, for GPU-via-SkyPilot from the
#   notebook -- built from singleuser/Dockerfile.skypilot): ghcr.io/nolabs-ai/jupyter-hub-setup/singleuser-skypilot:latest
# Plain data science (CPU): quay.io/jupyter/datascience-notebook:python-3.13
# GPU-on-host (PyTorch + CUDA): quay.io/jupyter/pytorch-notebook:cuda12-python-3.13
SINGLEUSER_IMAGE=ghcr.io/nolabs-ai/jupyter-hub-setup/singleuser-skypilot:latest

# Optional: pull policy ("ifnotpresent" uses a pre-pulled local image; "always" re-pulls
# every spawn). Spawn timeouts (first pull can be slow): SPAWN_START_TIMEOUT (default 600s).
# SINGLEUSER_PULL_POLICY=ifnotpresent

# Path on the host to mount into user containers for large models/data
HOST_WORKSPACE=/workspace

# Subdirectory under HOST_WORKSPACE that will be mounted into each
# user’s home as ~/Shared for easy collaboration
SHARED_DIR=shared

# Enable GPU access for user containers (requires NVIDIA Container Toolkit)
ENABLE_GPU=true
