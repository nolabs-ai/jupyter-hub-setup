# SkyPilot-ready singleuser image for the decoupled hub.
#
# JupyterLab (standard datascience stack) + the SkyPilot client + gcloud, so researchers
# launch GPU jobs from the notebook (`sky launch ...`) instead of the hub box having a GPU.
# Job VMs run as the skypilot-v1 SA (SERVICE_ACCOUNT) via the preloaded ~/.sky/config.yaml,
# so no personal credentials land on the ephemeral GPU VMs. GCP auth in the notebook comes
# from the hub VM's attached SA via the metadata server (Application Default Credentials).
FROM quay.io/jupyter/datascience-notebook:python-3.13

USER root

# gcloud CLI (SkyPilot shells out to it) + rsync/ssh (SkyPilot needs them client-side to
# provision and sync files to the VM) + gh (GitHub CLI).
RUN apt-get update \
 && apt-get install -y --no-install-recommends apt-transport-https ca-certificates gnupg curl rsync openssh-client \
 && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends google-cloud-cli gh \
 && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}

# SkyPilot client (GCP extras). PINNED to match the shared API server version
# (training-infra gcp-api-server, currently 0.13.0) -- SkyPilot enforces client<->server
# version compatibility, so bump these together.
RUN pip install --no-cache-dir "skypilot[gcp]==0.13.0"

# Preload the sky config:
#  - allowed_clouds: [gcp] -> SkyPilot only checks/uses GCP, so `sky check` shows one clean
#    block instead of ~40 disabled providers (and skips the noisy DO/azure adapter traceback).
#  - gcp.remote_identity: SERVICE_ACCOUNT -> GPU job VMs run as the skypilot-v1 SA (no personal
#    creds uploaded).
RUN mkdir -p /home/${NB_USER}/.sky \
 && printf 'allowed_clouds:\n  - gcp\ngcp:\n  remote_identity: SERVICE_ACCOUNT\n' > /home/${NB_USER}/.sky/config.yaml
